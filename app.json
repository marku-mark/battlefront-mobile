{
  "expo": {
    "name": "Battlefront",
    "slug": "battlefront-mobile",
    "scheme": "battlefront",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/battlefront-app-icon.png",
    "backgroundColor": "#090b10",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/battlefront-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#090b10"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#ef1b1b"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment proof image for your Battlefront order.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.battlefront.mobile"
    },
    "android": {
      "package": "com.battlefront.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/battlefront-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/battlefront-app-icon.png",
      "splash": {
        "image": "./assets/battlefront-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#090b10"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f470ac29-4c52-4a08-932a-452f3810a3c6"
      }
    },
    "owner": "ifnothing"
  }
}
