{
  "expo": {
    "name": "Battlefront",
    "slug": "battlefront-mobile",
    "scheme": "battlefront",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/battlefront-app-icon.png",
    "backgroundColor": "#090b10",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/battlefront-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#090b10"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.battlefront.mobile"
    },
    "android": {
      "package": "com.battlefront.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/battlefront-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/battlefront-app-icon.png",
      "splash": {
        "image": "./assets/battlefront-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#090b10"
      }
    }
  }
}
