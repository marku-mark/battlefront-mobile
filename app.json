{
  "expo": {
    "name": "Battlefront",
    "slug": "battlefront-mobile",
    "scheme": "battlefront",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/battlefront-app-icon.png",
    "backgroundColor": "#f4f0eb",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/battlefront-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#f4f0eb",
          "android": {
            "image": "./assets/battlefront-adaptive-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#f4f0eb"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "order-updates-v2",
          "color": "#ef1b1b",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment proof image for your Battlefront order.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.battlefront.mobile"
    },
    "android": {
      "package": "com.battlefront.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/battlefront-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/battlefront-app-icon.png",
      "splash": {
        "image": "./assets/battlefront-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#f4f0eb"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f470ac29-4c52-4a08-932a-452f3810a3c6"
      }
    },
    "owner": "ifnothing",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f470ac29-4c52-4a08-932a-452f3810a3c6"
    }
  }
}
